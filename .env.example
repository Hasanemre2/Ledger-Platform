# ===================================================================
# Core-Banking Ledger Platform - Ortam Değişkenleri Şablonu (.env.example)
# ===================================================================
# Bu dosya bir şablondur. Gerçek şifrelerinizi ve ortam ayarlarınızı
# tanımlamak için bu dosyayı '.env' adıyla kopyalayın:
#
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# DİKKAT: '.env' dosyası hassas şifreler barındırır ve .gitignore
# tarafından korunur. ASLA '.env' dosyasını Git veya GitHub'a yüklemeyin!
# ===================================================================

# -------------------------------------------------------------------
# 1. ORACLE VERİTABANI AYARLARI
# -------------------------------------------------------------------
# Oracle Docker konteyner başlatılırken kullanılacak şifreler
ORACLE_SYS_PASSWORD=LedgerAdmin2024
ORACLE_APP_USER=LEDGER_USER
ORACLE_APP_PASSWORD=LedgerPass2024

# C# Uygulamaları (Consumer & Dashboard) için Oracle Bağlantı Dizesi
# Format: User Id=<USER>;Password=<PASSWORD>;Data Source=<HOST>:<PORT>/<SERVICE_NAME>;...
ORACLE_CONN_STRING=User Id=LEDGER_USER;Password=LedgerPass2024;Data Source=127.0.0.1:1522/XEPDB1;Min Pool Size=4;Max Pool Size=100;Connection Timeout=60;Pooling=true;

# -------------------------------------------------------------------
# 2. APACHE KAFKA AYARLARI
# -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
KAFKA_TOPIC=ledger-transactions
KAFKA_GROUP_ID=ledger-arraybinding-group

# -------------------------------------------------------------------
# 3. KAFKA SASL / BULUT BAĞLANTISI (Opsiyonel - Confluent Cloud, Upstash vb.)
# -------------------------------------------------------------------
# Yerel Docker ortamında boş bırakılabilir. Bulut Kafka kullanırken doldurunuz:
# KAFKA_SASL_USERNAME=your_kafka_api_key
# KAFKA_SASL_PASSWORD=your_kafka_api_secret
# KAFKA_SECURITY_PROTOCOL=SaslSsl
# KAFKA_SASL_MECHANISM=Plain

# -------------------------------------------------------------------
# 4. DASHBOARD VE İŞLEM TARİHİ AYARLARI
# -------------------------------------------------------------------
DASHBOARD_URL=http://localhost:5000
BUSINESS_DATE=2026-09-18
